{
  "schemaVersion": 1,
  "id": "playerlib",
  "version": "${version}",
  "name": "Player Control Library",
  "description": "Library for emulating keyboard, mouse, camera control and player data management",
  "authors": ["kisiqrt"],
  "contact": {
    "homepage": "https://github.com/v11859752/player-control-lib",
    "sources": "https://github.com/v11859752/player-control-lib",
    "issues": "https://github.com/v11859752/player-control-lib/issues"
  },
  "license": "MIT",
  "icon": "assets/playerlib/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.playerlib.PlayerControlMod"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "provides": [
    "player-control-api"
  ]
}